# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.lighthouseci/
/playwright-report/
/test-results/

# next.js
/.next/
/apps/*/.next/
/out/

# production
/build
/.turbo/
**/.turbo/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
**/.dev.vars*

# vercel
.vercel

# cloudflare local state and dry-run bundles
**/.wrangler/

# supabase local state
supabase/.temp/

# sanity local build/runtime state
**/.sanity/

# typescript
*.tsbuildinfo
next-env.d.ts
.neon
