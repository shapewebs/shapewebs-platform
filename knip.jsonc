{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["k6"],
  "ignoreDependencies": ["k6"],
  "workspaces": {
    ".": {
      "entry": [
        "checkly.config.ts",
        "lighthouserc.cjs",
        "monitoring/checks/*.ts",
        "tests/load/*.js",
      ],
    },
    "workers/outbox-scheduler": {
      "entry": ["tests/**/*.test.ts"],
    },
  },
}
