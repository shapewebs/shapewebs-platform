{
  "name": "shapewebs-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "node tooling/scripts/run-turbo-dev.mjs",
    "dev:web": "node tooling/scripts/run-turbo-dev.mjs --filter=@shapewebs/web",
    "dev:admin": "node tooling/scripts/run-turbo-dev.mjs --filter=@shapewebs/admin",
    "build": "pnpm --filter @shapewebs/web build && pnpm --filter @shapewebs/admin build",
    "build:turbopack": "pnpm --filter @shapewebs/web exec next build --turbopack && pnpm --filter @shapewebs/admin exec next build --turbopack",
    "build:webpack": "pnpm --filter @shapewebs/web exec next build --webpack && pnpm --filter @shapewebs/admin exec next build --webpack",
    "build:workers": "pnpm --filter @shapewebs/outbox-scheduler build",
    "check:boundaries": "node tooling/scripts/check-client-boundaries.mjs",
    "check:cycles": "knip --production --cycles",
    "check:deps": "knip",
    "check:generated": "pnpm --filter @shapewebs/auth auth:schema:check && pnpm --filter @shapewebs/database db:check",
    "check:runtime-artifacts": "node tooling/scripts/verify-runtime-artifacts.mjs",
    "css:class:create": "node tooling/scripts/create-css-class-name.mjs",
    "css:classes:check": "node tooling/scripts/verify-css-class-names.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:docs": "markdownlint-cli2 '**/*.md' '#**/node_modules/**' '#**/.next/**' '#**/.wrangler/**' '#.lighthouseci/**' '#playwright-report/**' '#test-results/**' '#CLAUDE.md'",
    "monitoring:checkly:list": "checkly test --list --no-record",
    "monitoring:checkly:validate": "tsc --project monitoring/tsconfig.json",
    "security:asvs:check": "node tooling/scripts/generate-asvs-evidence.mjs --check && node tooling/scripts/verify-asvs-evidence.mjs",
    "security:asvs:gate": "node tooling/scripts/generate-asvs-evidence.mjs --check && node tooling/scripts/verify-asvs-evidence.mjs --launch-gate",
    "security:asvs:generate": "node tooling/scripts/generate-asvs-evidence.mjs",
    "security:asvs:update": "node tooling/scripts/update-asvs-catalog.mjs",
    "security:dependency-patches:check": "node tooling/scripts/verify-dependency-patches.mjs",
    "sanity:cli": "pnpm --filter @shapewebs/content-studio exec sanity",
    "studio:build": "pnpm --filter @shapewebs/content-studio build",
    "studio:dev": "pnpm --filter @shapewebs/content-studio dev",
    "studio:schema:validate": "pnpm --filter @shapewebs/content-studio schema:validate",
    "studio:typecheck": "pnpm --filter @shapewebs/content-studio typecheck",
    "test": "vitest run",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:coverage": "vitest run --coverage",
    "test:database:content-list": "vitest run --config vitest.database.config.ts",
    "test:e2e": "playwright test",
    "test:headers": "playwright test tests/e2e/security.spec.ts",
    "test:load:smoke": "node tooling/scripts/run-k6-smoke.mjs",
    "test:performance": "lhci autorun",
    "test:workers": "pnpm --filter @shapewebs/outbox-scheduler test:runtime",
    "test:zap:baseline": "node tooling/scripts/run-zap-baseline.mjs",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm lint:docs && pnpm css:classes:check && pnpm visual:foundation:check && pnpm typecheck && pnpm studio:schema:validate && pnpm monitoring:checkly:validate && pnpm security:asvs:check && pnpm security:dependency-patches:check && pnpm test:workers && pnpm test:coverage && pnpm check:boundaries && pnpm check:deps && pnpm check:cycles && pnpm check:generated && pnpm audit",
    "verify:release": "pnpm verify && pnpm build:workers && pnpm studio:build && pnpm build:turbopack && pnpm build:webpack && pnpm check:runtime-artifacts && pnpm test:e2e && pnpm test:performance && pnpm test:load:smoke && pnpm test:zap:baseline && pnpm security:asvs:gate",
    "visual:foundation:check": "node tooling/scripts/verify-visual-foundation.mjs",
    "clean": "pnpm clean:artifacts",
    "clean:artifacts": "node tooling/scripts/clean-artifacts.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.1",
    "@sanity/webhook": "4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.10",
    "brace-expansion": "5.0.8",
    "checkly": "8.17.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-plugin-security": "4.0.1",
    "jose": "6.2.4",
    "knip": "6.29.0",
    "markdownlint-cli2": "0.23.1",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "turbo": "2.10.6",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
